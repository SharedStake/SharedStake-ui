{
  "name": "sharedstake-ui",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "setup": "bun install && bash scripts/install-pre-commit-hook.sh",
    "postinstall": "bash scripts/install-pre-commit-hook.sh",
    "serve": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "lint": "eslint src --ext .vue,.js,.ts --fix",
    "lint:fix": "eslint src --ext .vue,.js,.ts --fix",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "dev": "vite",
    "start": "vite",
    "test": "echo \"No tests specified\" && exit 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:fork": "bash scripts/contracts/run-fork-e2e.sh",
    "test:e2e:fork:wallet": "bash scripts/contracts/run-fork-e2e.sh --with-wallet",
    "test:e2e:wallet": "playwright test -c playwright.wallet.config.js",
    "test:e2e:wallet:strict": "bash scripts/contracts/validate-wallet-env.sh && PW_WALLET_REQUIRE_ENV=1 PW_WALLET_ENFORCE_REAL_CONNECT=true playwright test -c playwright.wallet.config.js",
    "test:e2e:wallet:headed": "PW_WALLET_HEADLESS=0 playwright test -c playwright.wallet.config.js --headed",
    "test:e2e:wallet:debug": "PWDEBUG=1 playwright test -c playwright.wallet.config.js --headed --workers=1",
    "contracts:init": "bash scripts/contracts/init-shareddeposit.sh",
    "contracts:deploy:local": "bash scripts/contracts/deploy-local.sh --network localhost",
    "contracts:sync:local": "bash scripts/contracts/sync-addresses.sh localhost src/contracts/addresses/local.json",
    "contracts:drift:local": "bash scripts/contracts/check-drift.sh localhost src/contracts/addresses/local.json",
    "audit": "bun audit --level moderate || true",
    "audit:strict": "bun audit --level moderate",
    "clean": "rm -rf dist node_modules/.cache",
    "prebuild": "bun run clean",
    "postbuild": "echo \"Build completed successfully\"",
    "docker:build": "docker build -t sharedstake-ui .",
    "docker:run": "docker run -p 8080:8080 sharedstake-ui",
    "optimize:images": "bun run scripts/optimize-images.js",
    "analyze:bundle": "vite build --mode analyze",
    "analyze:security": "bun audit --level moderate",
    "pre-commit": "bash scripts/pre-commit-check.sh",
    "pre-commit:fix": "bash scripts/fix-pre-commit-issues.sh",
    "pre-commit:install": "bash scripts/install-pre-commit-hook.sh"
  },
  "dependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-syntax-bigint": "7.8.3",
    "@babel/plugin-transform-optional-chaining": "7.28.6",
    "@babel/preset-env": "7.29.0",
    "@web3-onboard/core": "2.24.1",
    "@web3-onboard/injected-wallets": "2.11.3",
    "axios": "1.16.1",
    "bignumber.js": "9.3.1",
    "bnc-notify": "1.9.8",
    "core-js": "3.48.0",
    "ethers": "6.16.0",
    "marked": "16.4.1",
    "pinia": "3.0.4",
    "vue": "3.5.27",
    "vue-ellipse-progress": "2.2.0",
    "vue-router": "4.6.4",
    "vue-toastification": "2.0.0-rc.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.28.6",
    "@playwright/test": "^1.60.0",
    "@types/webpack-env": "1.18.8",
    "@vitejs/plugin-vue": "6.0.4",
    "autoprefixer": "10.4.24",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.2",
    "globals": "16.5.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.2.4"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "vue/no-reserved-component-names": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "overrides": {
    "crypto-es": "2.1.0",
    "postcss": "8.5.6",
    "ws": "8.18.3",
    "cross-spawn": "7.0.6",
    "nanoid": "5.1.6",
    "esbuild": "0.25.11",
    "glob": "10.5.0",
    "node-forge": "1.3.3",
    "svelte": "4.2.19",
    "js-yaml": "4.1.1"
  }
}
