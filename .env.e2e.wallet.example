# Wallet extension E2E settings
# Copy this file to .env.e2e.wallet and export values before running:
# playwright test -c playwright.wallet.config.js
# or: bun run test:e2e:fork:wallet

PW_WALLET_BASE_URL=http://127.0.0.1:4173
PW_WALLET_WEBSERVER_URL=http://127.0.0.1:4173
PW_WALLET_WEBSERVER_COMMAND=bun run dev -- --host 127.0.0.1 --port 4173

# Optional app env for local/fork wallet testing
# export VITE_ONBOARD_CHAIN_ID=0x7a69
# export VITE_ONBOARD_CHAIN_RPC_URL=http://127.0.0.1:8545
# export VITE_ONBOARD_CHAIN_LABEL=Localhost Fork
# export VITE_ONBOARD_CHAIN_TOKEN=ETH

# Required for wallet-connect.spec.js
PW_WALLET_EXTENSION_PATH=/absolute/path/to/chromium-extension
PW_WALLET_EXTENSION_ID=abcdefghijklmnopqrstuvwxyzabcdef
PW_WALLET_TEST_ADDRESS=0x1111111111111111111111111111111111111111

# Optional
PW_WALLET_NAME=MetaMask
PW_WALLET_CONNECT_PATH=/earn
PW_WALLET_HEADLESS=true
PW_WALLET_EXTENSION_TIMEOUT_MS=15000
# Set true to require an actual extension-backed wallet connection in the spec.
PW_WALLET_ENFORCE_REAL_CONNECT=false
PW_WALLET_SKIP_WEBSERVER=0
# Optional: exact ETH balance applied to PW_WALLET_TEST_ADDRESS during fork wallet runs
PW_WALLET_SEED_ETH=5
