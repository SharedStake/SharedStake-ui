NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DATABASE_URL=file:../data/referrals.db

# Comma-separated API keys for admin endpoints.
API_KEYS=local-dev-key-change-me

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20

# Onchain sync worker configuration
CHAIN_ID=1
RPC_URL=http://127.0.0.1:8545
ONCHAIN_REFERRAL_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SYNC_POLL_INTERVAL_MS=30000
SYNC_CONFIRMATIONS=3
# SYNC_START_BLOCK=0
