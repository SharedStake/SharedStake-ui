{
  "name": "@sharedstake/referral-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force --skip-seed",
    "seed": "tsx prisma/seed.ts",
    "worker:sync": "tsx src/worker/onchainSync.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.29",
    "prisma": "^6.8.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
