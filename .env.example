# SharedStake UI Environment Variables

# Ethereum RPC URL (optional - fallback is configured)
# Override with your own API key for production:
# VITE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_NEW_API_KEY_HERE

# Wallet onboarding chain config (optional).
# Defaults: Mainnet / ETH / VITE_RPC_URL.
# For local fork E2E:
# VITE_ONBOARD_CHAIN_ID=0x7a69
# VITE_ONBOARD_CHAIN_RPC_URL=http://127.0.0.1:8545
# VITE_ONBOARD_CHAIN_LABEL=Localhost Fork
# VITE_ONBOARD_CHAIN_TOKEN=ETH

# Alternative RPC providers:
# VITE_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
# VITE_RPC_URL=https://ethereum.publicnode.com
# VITE_RPC_URL=https://rpc.ankr.com/eth

# Note: BlastAPI access ends October 2025, so avoid:
# VITE_RPC_URL=https://eth-mainnet.public.blastapi.io

# Etherscan API key — used by Landing page TVL fetch.
# Leave blank to skip the call (non-fatal — UI still loads without it).
# VITE_ETHERSCAN_KEY=YOUR_ETHERSCAN_API_KEY_HERE
