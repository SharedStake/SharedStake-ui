[Unit]
Description=SharedStake Keeper - withdrawalFinalizer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sharedstake
Group=sharedstake
WorkingDirectory=/opt/sharedstake/SharedDeposit
EnvironmentFile=/etc/sharedstake/keeper.env
ExecStart=/usr/bin/env npx ts-node scripts/keepers/withdrawalFinalizer.ts --watch --interval=120
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/sharedstake/SharedDeposit
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
