[Unit]
Description=SharedStake Keeper - veSGTCheckpointer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sharedstake
Group=sharedstake
WorkingDirectory=/opt/sharedstake/SharedStake-ui/staking-contracts
EnvironmentFile=/etc/sharedstake/keeper.env
ExecStart=/usr/bin/env npx ts-node scripts/keepers/veSGTCheckpointer.ts --watch --interval=300
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/sharedstake/SharedStake-ui/staking-contracts
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
